# ==============================================================================
# BIG BASKET - FULL-STACK ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL or SQLite)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/bigbasket_db?schema=public
# For SQLite (Zero setup dev default): file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_bigbasket_grocery_2026_dev_mode
JWT_EXPIRES_IN=7d

# Default Super Admin Seed Credentials
ADMIN_NAME="Big Basket Admin"
ADMIN_EMAIL=admin@bigbasket.local
ADMIN_PASSWORD=admin123
ADMIN_PHONE="9876543210"

# File Upload Storage
UPLOAD_DIR=uploads

# Razorpay Online Payment Gateway (Optional - COD works natively without keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
