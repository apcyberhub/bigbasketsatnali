# ==============================================================================
# BIG BASKET BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Big Basket E-Commerce API"
API_V1_STR="/api"

# Database Configuration (PostgreSQL or SQLite fallback for testing)
# PostgreSQL default: postgresql://postgres:password@localhost:5432/bigbasket_local
# SQLite testing: sqlite:///./bigbasket_local.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bigbasket_local

# Security & JWT Tokens
# Generate random secret: openssl rand -hex 32
SECRET_KEY=change-this-super-secret-key-in-production-bigbasket-satnali-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay Payment Gateway (Test Mode / Production)
# Get keys from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretHere
# Webhook Secret from Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# CORS Allowed Origins (Comma separated or JSON array)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000"]
