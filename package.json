{
  "name": "bigbasket-fullstack",
  "version": "1.0.0",
  "description": "Big Basket - Complete Full-Stack Grocery E-Commerce Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build:server && npm run build:client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:generate": "npm run db:generate --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:studio": "npm run db:studio --prefix server",
    "test": "npm run test --prefix server",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.3.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2",
    "prisma": "^5.22.0",
    "tsx": "^4.23.12"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
